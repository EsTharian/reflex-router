 "findings": {
  "mcp_draft04_boolean_exclusive_bounds": {
   "status": "verified_accepted_by_api_in_scope",
   "construct": "properties.n: {minimum:0, exclusiveMinimum:true}; properties.m: {maximum:10, exclusiveMaximum:false}; $schema draft-04",
   "evidence_file": "haiku-mcp-draft4.main-new-turn.request.json",
   "response_status": 200,
   "scope": "one request, model claude-haiku-4-5-20251001, entrypoint sdk-cli, local stdio MCP server, custom ANTHROPIC_BASE_URL",
   "not_tested": [
    "Sonnet/Opus/Fable targets",
    "other draft-04 constructs (id, definitions, type arrays)",
    "interactive entrypoint",
    "servers that declare many tools"
   ],
   "interpretation": "Claude Code does not rewrite the schema when a custom base URL is set, and Haiku 4.5 accepted it. This does NOT establish that every model accepts it, so a compat rewrite is not currently required but is not disproven for other targets."
  },
  "sonnet_to_haiku_retarget": {
   "status": "verified_in_scope",
   "result": "Fully rewritten request accepted (HTTP 200); claude completed the run.",
   "necessary": {
    "output_config.effort removed": "400 'This model does not support the effort parameter.' when kept",
    "thinking adaptive -> {type:enabled, budget_tokens}": "400 'adaptive thinking is not supported on this model' when kept",
    "role:system messages folded into user messages": "400 \"role 'system' is not supported on this model\" when kept"
   },
   "not_necessary": {
    "max_tokens capped at 32000": "accepted with 64000",
    "effort-*/mid-conversation-system-* beta headers removed": "accepted with them present"
   },
   "scope": "one request, first turn of a fresh conversation (no assistant history), Sonnet 5 -> Haiku 4.5, sdk-cli entrypoint, budget_tokens 31999 with max_tokens 64000",
   "not_tested": [
    "mid-conversation switches (Sonnet-generated thinking blocks with signatures already in the history)",
    "requests with prior tool_use/tool_result turns",
    "Opus/Fable as target",
    "the context-1m beta",
    "subagent (5-minute cache) requests",
    "thinking.display values other than 'omitted'",
    "the API reports one error at a time, so 'necessary' comes from leave-one-out, not from the error text alone"
   ]
  },
  "route_sonnet_to_haiku": {
   "status": "verified_in_scope",
   "date": "2026-09-19",
   "est_cost_usd": 0.068,
   "accepted": {
    "subagent first request -> Haiku": "200",
    "subagent pinned continuation (Haiku history, system messages mid-list + trailing folded)": "200",
    "main continuation with a signed Sonnet thinking block in history, kept": "200",
    "same, history thinking dropped": "200",
    "same, thinking without display (interactive shape)": "200",
    "same, + redact-thinking-2026-02-12 beta (interactive header)": "200",
    "main pinned continuation (Haiku turns in history) -> Haiku": "200",
    "un-pin: original bytes to Sonnet with Sonnet + Haiku thinking blocks in history": "200"
   },
   "decision": "keep history thinking blocks (fewer edits); dropping is available but not needed",
   "caveat": "accepted means HTTP 200 and a normal stream; it does not show whether a model used or ignored thinking blocks signed by another model",
   "not_tested": [
